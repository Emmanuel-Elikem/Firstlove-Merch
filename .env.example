# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Paystack API Keys (server + Vite public key — no hard-coded fallbacks in code)
# Checkout only needs the secret key. In the Paystack dashboard (Settings → API Keys & Webhooks) set:
#   Callback URL: {APP_URL}/payment-callback
#   Webhook URL:  {APP_URL}/api/paystack-webhook
# Paid orders are pushed to the FLC Shirts delivery list (flc_items table) using the
# Supabase keys below, so set those too in production.
PAYSTACK_SECRET_KEY="sk_test_YOUR_PAYSTACK_SECRET_KEY"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_YOUR_PAYSTACK_PUBLIC_KEY"

# Supabase Storage only (optional). When BOTH are set, the Express server stores
# orders.json + basontas.json in private bucket merch-data and images in public
# bucket merch-photos (no database tables). When unset, local data/*.json +
# public/images are used exactly as before (AI Studio / local fallback).
# SUPABASE_SERVICE_ROLE_KEY is SERVER-SIDE ONLY — never expose it as VITE_* or in the browser.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
